# Dependencies. This became a ROOT-level concern when the repo moved to npm
# workspaces: `npm install` now hoists every package into a root node_modules,
# which did not exist before and which the per-package .gitignore files do not
# cover.
node_modules/

# Build output
dist/

ree-tracker-backend/firebase-service-account.json.json
.env
.env.local
.env.*.local

# Claude Code local state — credentials, caches, session history, plans.
# Ignore everything under .claude/ EXCEPT the shared dev-server launch config.
.claude/*
!.claude/launch.json
