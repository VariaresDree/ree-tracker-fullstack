{
  "name": "@ree/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Business rules that MUST agree between the web client and the API. Authored in CommonJS so Node can require() it directly; Vite pre-bundles it for the browser (see optimizeDeps in ree-tracker/vite.config.js).",
  "type": "commonjs",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "browser": "./src/client.js",
      "default": "./src/index.js"
    },
    "./paperSets": "./src/paperSets.js",
    "./modelJson": "./src/modelJson.js",
    "./explanation": "./src/explanation.js",
    "./questionReplace": "./src/questionReplace.js",
    "./outsideScores": "./src/outsideScores.js",
    "./subtopics": "./src/subtopics.js",
    "./subtopicTagPrompt": "./src/subtopicTagPrompt.js",
    "./boardItems": "./src/boardItems.js",
    "./units": "./src/units.js",
    "./srs": "./src/srs.js"
  },
  "files": [
    "src"
  ]
}
