# Postgres (Supabase / Neon / any provider)
#
# On Render (and Vercel, GitHub Actions — any IPv4-only network): Supabase's
# direct connection host (db.<ref>.supabase.co) resolves IPv6-only on the free
# tier, causing `connect ENETUNREACH <ipv6 address>` at boot. Use the Supavisor
# SESSION POOLER connection string instead (IPv4, supports prepared statements
# — unlike transaction mode, which the pg driver adapter needs):
#   postgresql://postgres.<project-ref>:<password>@aws-<N>-<region>.pooler.supabase.com:5432/postgres
# Get the exact host/N from Supabase Dashboard -> Connect -> Session pooler.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# AI providers. Each AI feature has its own model chain (src/config/aiModels.js);
# a provider without a key is skipped. Any one key serves every text feature.
#   GROQ_API_KEY        free at console.groq.com; open models (gpt-oss, Llama).
#                       First choice for the board report, explanations and
#                       admin generation.
#   CEREBRAS_API_KEY    free tier at cloud.cerebras.ai; same open models, backup.
#   OPENROUTER_API_KEY  openrouter.ai; free ":free" model routes, backup.
#   GEMINI_API_KEY      Google AI Studio; reads images, and the last backup.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional: replace a feature's chain, e.g.
# AI_CHAIN_REPORT=groq:openai/gpt-oss-20b,gemini:gemini-2.5-flash-lite

# Firebase Admin — paste service account JSON values (private key needs \n escaped)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CORS allowlist
FRONTEND_URL=http://localhost:5173

# Optional: scheduled reminders. A long random string shared with the GitHub
# repository secret of the same name; .github/workflows/reminders.yml sends it
# in the x-cron-secret header to POST /api/cron/reminders. Unset = the route
# answers 503 and no reminder is sent.
# CRON_SECRET=

# Optional: storage driver. Leave unset for local-disk under ./uploads
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=ree-materials
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Optional: requests per IP per 15 minutes (default 300). Raised for the
# signed-in Playwright run, which sends every request from one address.
# RATE_LIMIT_GLOBAL_MAX=300
